{
  "name": "chirp-wa",
  "version": "0.1.0",
  "description": "Chirp for WhatsApp: a keyboard-first terminal client with local history and media previews",
  "type": "module",
  "bin": {
    "chirp": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/chunks/*.js",
    "dist/protocol/*.cjs",
    "dist/THIRD_PARTY_LICENSES.txt",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx --disable-warning=ExperimentalWarning src/cli.tsx",
    "start": "node --max-semi-space-size=1 --optimize-for-size --disable-warning=ExperimentalWarning dist/cli.js",
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --disable-warning=ExperimentalWarning --test test/*.test.ts test/*.test.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run check && npm test",
    "check:package": "node scripts/check-package.mjs",
    "check:protocol": "node benchmarks/runner/check-protobuf.mjs",
    "check:yoga": "node benchmarks/runner/check-yoga.mjs",
    "test:terminal": "node benchmarks/runner/check-packaged.mjs",
    "smoke:connect": "tsx scripts/smoke-connect.ts",
    "smoke:session": "tsx scripts/smoke-session.ts",
    "prepack": "npm run build && npm run check:package",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "chalk": "^5.6.2",
    "commander": "^14.0.0",
    "emojibase-data": "^17.0.0",
    "ink": "^6.8.0",
    "jimp": "^1.6.0",
    "mime-types": "^3.0.1",
    "open": "^10.2.0",
    "pino": "^9.14.0",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "sharp": "^0.35.5",
    "string-width": "^8.3.0",
    "strip-ansi": "^7.2.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "whatsapp-rust-bridge": "0.5.4"
  },
  "optionalDependencies": {
    "@crosscopy/clipboard": "^0.3.6"
  },
  "license": "MIT",
  "keywords": [
    "whatsapp",
    "terminal",
    "cli",
    "tui",
    "baileys",
    "chat"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sallytion/chirp-wa.git"
  },
  "homepage": "https://github.com/Sallytion/chirp-wa#readme",
  "bugs": {
    "url": "https://github.com/Sallytion/chirp-wa/issues"
  }
}
